frontend/.angular/
frontend/dist/

# ---------- LaTeX (pasta tcc/) ----------
tcc/**/*.aux
tcc/**/*.bbl
tcc/**/*.blg
tcc/**/*.fdb_latexmk
tcc/**/*.fls
tcc/**/*.log
tcc/**/*.out
tcc/**/*.toc
tcc/**/*.lof
tcc/**/*.lot
tcc/**/*.synctex.gz

