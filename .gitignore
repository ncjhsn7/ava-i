# ---------- Segredos ----------
.env
.env.*
**/.env
**/.env.*
!**/.env.example

# ---------- Python (backend e avaliacao) ----------
venv/
.venv/
**/venv/
**/.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Dados locais gerados pelo app ----------
backend/*.db
backend/*.db-journal
backend/chroma_data/
backend/uploads/
backend/logs/
*.log

# ---------- Avaliação (LLM-as-a-judge) ----------
avaliacao/logs/
avaliacao/tmp/
# Os .jsonl de avaliacao/dados/ contêm trechos dos PDFs das disciplinas
# (material protegido por direitos autorais). Se o repositório for público,
# descomente a linha abaixo:
# avaliacao/dados/

# ---------- Frontend (Angular / Node) ----------
node_modules/
frontend/.angular/
frontend/dist/
frontend/out-tsc/
npm-debug.log*
yarn-error.log*
.npm/

# ---------- LaTeX (pasta tcc/) ----------
tcc/**/*.aux
tcc/**/*.bbl
tcc/**/*.blg
tcc/**/*.fdb_latexmk
tcc/**/*.fls
tcc/**/*.log
tcc/**/*.out
tcc/**/*.toc
tcc/**/*.lof
tcc/**/*.lot
tcc/**/*.synctex.gz

# ---------- Rascunhos e arquivos de ferramentas ----------
Claude outputs/
.claude/
*.tmp
~$*

# ---------- Sistema / editores ----------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
